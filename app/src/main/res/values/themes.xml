<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema "clasico" de la ventana de Android. Compose aplica su propio tema
         por encima; este solo controla el instante previo a que Compose dibuje.
         NoActionBar = sin la barra de titulo antigua. -->
    <style name="Theme.FocusZone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo_ventana</item>
    </style>

    <!-- Pantalla de carga (splash): fondo azul noche con el icono de la app.
         Se muestra mientras arranca la app y luego cambia sola al tema normal
         (postSplashScreenTheme). Igual en claro y oscuro: es la "marca". -->
    <style name="Theme.FocusZone.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FocusZone</item>
    </style>
</resources>
