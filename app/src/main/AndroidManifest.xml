<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         PERMISOS
         Declararlos aqui NO los concede: solo dice "esta app los usara".
         Los peligrosos (camara, notificaciones) se piden ademas en
         tiempo de ejecucion con un dialogo. Los "especiales" (uso de apps,
         accesibilidad, no molestar) los activas TU a mano en Ajustes.
         ============================================================ -->

    <!-- Camara: para ver el escritorio y colocar la zona de enfoque (Fase 1 y 2). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Mostrar la notificacion permanente de "sesion activa" (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Servicio en primer plano: mantiene el cronometro vivo con la pantalla apagada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Evita que el sistema duerma los sensores durante la sesion. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibrar al detectar que levantaste el celular antes de tiempo. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Activar/quitar No molestar durante la sesion. Ademas de declararlo, hay
         que concederlo a mano en Ajustes > Acceso a No molestar. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Desde Android 11 una app no "ve" las demas apps instaladas salvo que
         declare cuales le interesan. Aqui: las que salen en el menu de apps,
         para poder listarlas y elegir las distractoras. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- ============================================================
         CARACTERISTICAS DE HARDWARE
         required="false" = la app se instala aunque el celular no las tenga.
         ============================================================ -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${nombreApp}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusZone">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="${nombreApp}"
            android:theme="@style/Theme.FocusZone.Splash"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">

            <!-- Este bloque es lo que hace que la app aparezca en el menu de aplicaciones. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servicio que vigila la sesion con la pantalla apagada.
             specialUse = tipo de servicio en primer plano "de uso especial",
             obligatorio declararlo desde Android 14, con una explicacion. -->
        <service
            android:name=".sesion.ServicioSesion"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Temporizador de sesion de estudio que vigila el acelerometro para detectar si el usuario levanta el celular" />
        </service>

        <!-- Servicio de accesibilidad que bloquea las apps distractoras.
             El permiso BIND_ACCESSIBILITY_SERVICE garantiza que SOLO Android
             puede conectarse a el. Se activa a mano en Ajustes > Accesibilidad. -->
        <service
            android:name=".bloqueo.ServicioBloqueo"
            android:exported="true"
            android:label="${nombreApp}: bloqueo de apps"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/config_bloqueo" />
        </service>

    </application>

</manifest>
